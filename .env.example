# Copier vers .env (jamais committé). En production : variables d'env ou secrets Swarm.

# --- Base de données (docker-compose.yml) ---
POSTGRES_PASSWORD=postgres
DB_PORT=5440
DB_TEST_PORT=5441
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/shop
# Utilisée par les tests d'intégration (npm run test:integration)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5441/shop_test

# --- Backoffice ---
# Requise. Whitelist d'identifiants du service d'auth (users.id, entiers), séparés par des virgules.
# Vide = personne n'a accès au backoffice. Accès complet ou rien. Ex. : BACKOFFICE_USER_IDS=1,42
BACKOFFICE_USER_IDS=

# --- Authentification (auth-service) ---
# Toutes requises, validées au démarrage (src/server/config.ts).
# API d'auth-service back (/me, /refresh, /logout) et page de connexion d'auth-service front.
AUTH_API_URL=http://localhost:8080
AUTH_FRONT_URL=http://localhost:3005
# URL publique de la boutique, pour revenir après la connexion (jamais déduite de l'en-tête Host).
# Requise en production ; par défaut http://localhost:3000 hors production.
PUBLIC_URL=http://localhost:3000
# Même valeur que JWT_SECRET d'auth-service back : la boutique vérifie localement le cookie
# `access_token` (JWT HS256). Au moins 32 caractères en production (secret Swarm).
JWT_SECRET=

# --- Boutique ---
# Les garde-fous (plafond de wishlists, machines par facture, délai et blocage après abandon) sont
# lus dans la table ShopSettings, imposés par la base : pas de variable d'environnement.

# --- Paiement Bitcoin (service SIMULÉ au jalon 4, src/server/payment-service.ts) ---
# Facultatives. Prix d'un bitcoin en centimes d'euro (taux figé, défaut 9000000 = 90 000,00 €)
# et frais réseau estimés d'un remboursement en satoshis (défaut 2000).
PAYMENT_BTC_PRICE_EUR_CENTS=
PAYMENT_REFUND_NETWORK_FEE_SATS=
# Secret partagé avec le service de paiement : point d'entrée interne POST /api/internal/payments
# (en-tête Authorization: Bearer <secret>). Vide = point d'entrée fermé (404). Au moins 32
# caractères en production (secret Swarm). Ne jamais l'exposer au navigateur.
PAYMENT_WEBHOOK_SECRET=
