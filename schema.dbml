// Chauffagistes – boutique grossiste
// Modèle relationnel. Source de vérité des données, synchronisée avec prisma/schema.prisma.
// Montants en centimes d'euro (bigint). Devise unique : l'euro, aucune colonne devise.
// Contraintes non exprimables en Prisma (CHECK, index partiels, triggers, vues) :
// prisma/migrations/*_init, *_v4_option_stock, *_v5_orders_payments, *_v5b_orders_rules, *_v5c_abandoned_orders,
// *_v5d_line_position_db_clock, *_v5e_refund_address_send_renounce, *_v5f_refund_cause_address_log, *_v5g_admin_user_renounce_db_clock,
// *_v5h_lot_cancel_unpaid_orders et *_v5i_contact_email_dismissal_withdrawal (migration.sql),
// sections « Raw SQL ».
// Vues calculées à la lecture (jamais stockées) : part_stock, batch_part_needs, part_stock_pressure,
// order_payment_balance, order_creation_blocks, refunds_to_send, user_contact_email.
// Invariant : on ne supprime jamais une facture (Order), une ligne, un paiement ni un remboursement ;
// une adresse de paiement n'est jamais réutilisée (unique). Une facture survit à tout ce qui y est lié.
// Triggers « différés » : évalués au COMMIT ; une opération multi-requêtes
// (remplacement, annulation + remboursement…) se fait dans une seule transaction.
// Chaque erreur métier de trigger porte son nom dans le message : `(constraint "Nom")`
// (PrismaPg ne transmet pas le champ CONSTRAINT ; src/server/errors.ts lit le message).

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum option_kind {
  toggle   // Avec / Sans : deux OptionValue
  choice   // liste de valeurs (ex. kit de ventilation)
}

// Ordre métier (specs.md, « Tous les statuts »).
// Couples autorisés : fonction SQL batch_transition_allowed (revue logistique §5.1, T1–T18).
// Les conditions métier des transitions restent dans la fonction de domaine.
enum batch_status {
  draft               // Brouillon : invisible, première étape obligatoire
  survey              // Sondage : manifestation d'intérêt sans paiement
  preorder            // Précommande (ouverture = début de la journée de priorité)
  ordering            // Commande en cours (accessible directement depuis draft si financement direct)
  awaiting_reception  // Attente de réception
  inspection          // Contrôle : attribution des machines
  tuning              // Tuning : montage des options
  packaging           // Packaging : « commande » remplace « précommande »
  in_transit          // En transit : au moins une machine remise au transporteur
  closed              // Clôturé : terminal, toutes les machines livrées, perdues ou retournées et soldées
  cancelled           // Abandon : terminal, toute commande payée remboursée (trigger)
}

// Workflow du produit d'option, par produit et par lot (specs.md, « Confirmer la commande des options d'achat »)
// Avance seulement (BatchPartOrder_status_transition) : ordering → awaiting_delivery → delivered, ordering → delivered.
enum part_order_status {
  ordering            // Commande en cours
  awaiting_delivery   // Attente de livraison
  delivered           // Livré : la réception est dans le journal de stock (BatchPartOrder_reception)
}

// Mouvement du stock commun d'un produit d'option (CHECK PartStockMovement_kind_check)
enum part_movement_kind {
  reception    // entrée de kits livrés, qty > 0, rattachée ou non à une commande de lot
  adjustment   // correction manuelle d'inventaire, qty ≠ 0, motif (note) obligatoire
  kit_mounted  // kit monté sur une machine d'un lot : sortie, qty < 0, batch_id requis
}

enum machine_functional_status {
  unknown
  ok
  degraded   // hashboard défectueuse : marquée telle quelle, le technicien décide
  faulty     // morte : jamais préparée ni expédiée (CHECK), retirée du stock via scrapped
}

// Flux : expected → in_stock → in_preparation → ready → in_transit → delivered
// Transitions machine (revue §5.2, M1–M15) : fonction de domaine.
enum machine_logistical_status {
  expected         // attendue (créée à la création du lot ou à la réception)
  in_stock         // reçue
  in_preparation   // montage des options
  ready            // prête à expédier
  in_transit
  delivered
  missing          // jamais reçue : consomme une place du stock
  lost             // perdue en transit : consomme une place une fois détachée de sa ligne
  returned         // colis refusé / retourné
  scrapped         // morte, retirée du stock : consomme une place, jamais attribuée
}

enum hashboard_status {
  not_checked
  ok
  degraded
  dead
}

// Statut de la facture (= paiement). Consomment le stock : paid, et pending_payment tant que
// expires_at > now() (réservation de 30 min, lue sur l'horloge : expired n'est qu'un statut d'affichage).
// Transitions (trigger Order_guard) : pending_payment → paid | expired | refunded | cancelled ; expired → paid | refunded ;
//   cancelled → paid | refunded ; paid → refunded.
//   → expired : seulement après expires_at.
//   → paid : payée intégralement (received_sats >= expected_sats, CHECK Order_paid_in_full_check) ; lot ouvert
//     aux commandes ; un paiement tardif (ou un appoint tardif) n'est accepté que s'il reste de la place (Batch_stock).
//   pending/expired → refunded : paiement complet tardif sans place (Order_fits_stock faux), paiement incomplet
//     (remboursement choisi par l'utilisateur, frais à sa charge), ou lot fermé aux commandes (décision de l'admin) ;
//     quelque chose doit avoir été reçu (Order_refunded_payment_check).
//   pending_payment → cancelled : annulation volontaire, rien reçu (Order_cancel_unpaid), réservation vivante
//     (Order_cancel_expired). Libère le stock tout de suite ; c'est un abandon (délai et plafond, voir Order).
//   pending/expired → refunded avec un paiement partiel : remboursement choisi par l'utilisateur, avant ou après
//     l'expiration (frais à sa charge) ; libère la réservation tout de suite ; c'est un abandon.
//   cancelled → paid | refunded : paiement arrivé après l'annulation, décision de l'admin (needs_admin_decision).
//   Lot qui n'accepte plus de commande (v5h pour l'annulation, étendu en v5i à toute transition vers un statut où
//   batch_accepts_orders est faux : cancelled, in_transit, closed ; BatchStatusTransition_apply) : ses factures
//   pending_payment sans versement et à réservation vivante passent à cancelled dans la même transaction (jamais
//   supprimées, adresse de paiement conservée) ; un versement reçu ensuite reste « à traiter », sans remboursement
//   automatique. Le domaine verrouille ces factures AVANT le lot (changeBatchStatus), sinon interblocage avec un paiement.
//   cancelled → paid refusé si des sats de la facture ont été classés sans suite (Order_dismissed_final, v5i).
// Paiement partiel : la facture reste pending_payment (puis expired) en attente de l'appoint. Elle ne réserve que
// jusqu'à expires_at (immuable : un appoint ne prolonge rien) ; ensuite l'utilisateur choisit l'appoint (accepté s'il
// reste de la place) ou le remboursement (order_payment_balance.awaiting_user_decision, « à traiter » pour l'admin).
enum order_status {
  pending_payment
  paid
  expired
  refunded   // remboursement intégral : toutes les lignes ont un refund_id
  cancelled  // annulée en attente, rien reçu ; jamais supprimée
}

enum payment_method {
  bitcoin
}

// Nature d'un remboursement (CHECK Refund_kind_check : overpayment <=> amount = 0 ; trigger Refund_kind_lines)
enum refund_kind {
  cancellation  // annulation de lignes (au moins une ligne liée) ; au prorata sur une facture payée
  discount      // rabais sans ligne (ex. hashboard défectueuse) ; au prorata sur une facture payée
  overpayment   // sats reçus en trop, 0 € : excédent d'une facture payée, ou paiement arrivé après un remboursement intégral
}

// Qui supporte les frais réseau d'un remboursement : imposé par le motif à la création (refund_cause_fee_payer,
// trigger Refund_cause_fee_payer), immuable ensuite. CHECK Refund_fee_payer_check : user => network_fee_sats renseigné.
enum refund_fee_payer {
  shop  // frais tracés à part, jamais déduits
  user  // frais déduits de ce que reçoit l'utilisateur (amount_sats = brut − frais > 0, Refund_user_net_positive)
}

// Qui a décidé un remboursement (Refund.initiated_by), permis selon le motif (CHECK Refund_cause_check).
// CHECK Refund_admin_traced_check (NOT VALID : remboursements antérieurs à v5e) : admin <=> created_by_auth_user_id renseigné.
enum refund_initiator {
  user    // paiement partiel ; ou renoncement à une commande payée, lot au plus en Précommande
  admin   // à tout statut ; seul à accorder un rabais ; partial_payment seulement après l'expiration ; user_renounce à toute étape (à la demande de l'utilisateur)
  system  // traitement automatique : paiement tardif sans place (plus aucun excédent depuis v5h) ; montant > frais (Refund_system_above_fee)
}

// Motif d'un remboursement (Refund.cause), figé à la création. Payeur des frais : fonction unique
// refund_cause_fee_payer(cause) (défauts de Hugo, 2026-10-08 ; inverser = redéfinir la fonction, l'existant ne change pas).
// Nature et initiateur permis : CHECK Refund_cause_check.
enum refund_cause {
  shop_stock              // boutique : souci de stock, surplus, lot abandonné ; admin ou system ; lignes ou reliquat
  shop_defective_machine  // boutique : machine défectueuse ; admin ; lignes ou reliquat
  user_renounce           // utilisateur : renoncement (Refund_user_renounce_*) ; user, ou admin à sa demande ; lignes ou reliquat (sans frais)
  partial_payment         // utilisateur : paiement partiel (Refund_partial_payment_*) ; user ou admin ; toutes les lignes
  late_payment_no_room    // boutique : paiement tardif complet sans place (Refund_late_payment_full) ; system ou admin
  overpayment             // utilisateur : excédent ; admin seulement (v5h : jamais d'office) ; overpayment
  discount                // boutique : rabais ; admin ; discount
  admin_other             // boutique : autre annulation ou remboursement décidé par l'admin ; lignes ou reliquat
}

// Acteur déclaré par la transaction (fonction declare_actor) pour les journaux d'audit
enum actor_kind {
  user   // l'utilisateur de la facture (auth_user_id vérifié)
  admin  // un admin de la whitelist
}

// ─────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────

Table Model {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  hashrate bigint [not null, note: 'Hashrate théorique en H/s. CHECK > 0']
  hashboard_qtt int [not null, note: 'CHECK > 0']
  description text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(btrim(name))` [unique, name: 'Model_name_ci_key', note: 'Unique sans casse ni espaces de bord (migration catalog_unique_names)']
  }
}

// Stock (trigger différé Batch_check_stock, sous verrou de la ligne Batch) :
//   batch_available_stock(batch) = quantity − lignes payées − lignes réservées (facture
//   pending_payment, expires_at > now() : fonction order_holds_stock) − machines missing/scrapped/lost non rattachées à une
//   ligne active (batch_written_off) >= 0
//   et, par valeur d'option, batch_option_usage (lignes payées + réservées) <= BatchOptionValue.max_qty.
// Ces fonctions SQL sont la source unique de la règle : le domaine les appelle pour ses compteurs.
// Fonction Order_fits_stock(order_id) : la facture impayée tiendrait-elle si elle était payée maintenant ?
// Publication (sortie de draft, hors annulation) : instantané des menus (BatchOption) et des
// valeurs (BatchOptionValue) du modèle, pris par le trigger de BatchStatusTransition.
// Statuts (fonctions SQL, source unique) : batch_accepts_orders(status) = preorder à in_transit (création
// de facture, passage à paid) ; batch_is_public(status) = survey ou batch_accepts_orders (boutique publique).
Table Batch {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null, note: 'Rempli par défaut à la création : "{quantity} {Model.name}"']
  model_id uuid [not null, ref: > Model.id]
  status batch_status [not null, default: 'draft', note: 'Créé draft ; modifié uniquement par insertion dans BatchStatusTransition (trigger)']
  quantity int [not null, note: 'Nombre de machines du lot (stock théorique). CHECK > 0']
  purchase_price bigint [not null, note: 'Prix d\'achat du lot entier, centimes. CHECK >= 0']
  resale_unit_price bigint [note: 'Prix de revente à l\'unité (machine nue), centimes. Optionnel en brouillon, CHECK: obligatoire hors draft/cancelled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, model_id) [unique, note: 'Cible des FK composites batch/modèle']
    status
    model_id
  }
}

// Journal append-only des transitions de statut d'un lot.
// L'insertion vérifie from_status = statut courant et le couple autorisé (CHECK), puis applique to_status.
// Annulation refusée tant qu'une commande est paid.
// Aucun retour vers draft / survey une fois la précommande ouverte (seul survey → draft existe).
// Priorité (décision Hugo) : batch_priority_ends_at(batch) = première ouverture des précommandes
// (min(created_at) WHERE to_status = 'preorder') + 1 jour, pour un lot passé par le sondage et ayant au moins une
// wishlist active (NULL sinon : personne n'est prioritaire) ; plus tôt (dernière conversion) dès que toutes les
// wishlists actives sont converties. Détail : voir Order.
Table BatchStatusTransition {
  id uuid [pk, default: `gen_random_uuid()`]
  batch_id uuid [not null, ref: > Batch.id]
  from_status batch_status [note: 'NULL pour la création du lot (to_status = draft)']
  to_status batch_status [not null]
  changed_by_auth_user_id bigint [not null, note: 'auth.users.id du service d\'auth (admin de la whitelist). CHECK > 0']
  note text
  created_at timestamptz [not null, default: `clock_timestamp()`, note: 'Ordonne plusieurs transitions d\'une même transaction']

  indexes {
    (batch_id, created_at)
    (batch_id, to_status, created_at) [note: 'Date d\'ouverture des précommandes']
  }
}

// ─────────────────────────────────────────────
// Options (définies par modèle, réutilisables entre batchs)
// ─────────────────────────────────────────────

// Menu d'options (ex. « Kit de ventilation »).
// toggle (Avec/Sans) : exactement deux valeurs (OptionValue_toggle_two_values, différé) ; le défaut est
// « Sans » (gratuit) et ne change jamais : « Avec » n'est jamais le défaut (OptionValue_toggle_default_fixed).
Table Option {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [not null, ref: > Model.id]
  kind option_kind [not null, note: 'Figé dès que le menu a des valeurs (Option_kind_fixed)']
  title text [not null]
  description text
  position int [not null, default: 0]

  indexes {
    (id, model_id) [unique, note: 'Cible des FK composites option/modèle']
    (model_id, position)
    (model_id, `lower(btrim(title))`) [unique, name: 'Option_model_id_title_ci_key', note: 'Unique sans casse ni espaces de bord (migration catalog_unique_names) : titre unique par modèle']
  }
}

// Valeur d'un menu (ex. « Silent kit »).
// Invariant « exactement un défaut par option ayant au moins une valeur » :
//   au plus un  -> index unique partiel (option_id) WHERE is_default
//   au moins un -> trigger de contrainte différé (fin de transaction)
// Le défaut est la machine « brute » : prix 0 (CHECK OptionValue_default_free_check), aucune dérogation
// non nulle, jamais retiré d'un lot, et présent dans l'instantané de chaque lot publié où son menu
// s'applique (BatchOptionValue_default_enabled). La règle « défaut sans pièce » est supprimée (v4).
// Changement de défaut (OptionValue_default_change_locked, différé) : refusé s'il modifie une
// configuration vivante (wishlist non retirée, ligne non remboursée) d'un lot non clos ni annulé,
// c.-à-d. une configuration sans item dans ce menu (masqué ou non applicable : défaut implicite)
// ou ayant choisi à prix non nul la valeur qui devient le défaut.
// Prix et menu (option_id) figés tant que la valeur est proposée par un lot en cours, de survey à
// in_transit (ligne BatchOptionValue de l'instantané) : OptionValue_price_frozen / _option_frozen.
// Pour changer un prix sur ce lot : BatchOptionValue.price_override.
Table OptionValue {
  id uuid [pk, default: `gen_random_uuid()`]
  option_id uuid [not null, ref: > Option.id, note: 'Figé si proposée par un lot en cours (trigger)']
  label text [not null, note: 'Pour un toggle : "Avec …" / "Sans …"']
  is_default bool [not null, default: false, note: 'Défaut : gratuit, proposé par tous les lots (triggers différés) ; figé sur un toggle']
  price bigint [not null, default: 0, note: 'Prix catalogue, centimes. CHECK >= 0 ; 0 si is_default (CHECK). Figé si proposée par un lot en cours (trigger)']
  position int [not null, default: 0]

  indexes {
    (id, option_id) [unique, note: 'Cible des FK composites depuis ConfigurationItem / BatchOptionValue']
    (option_id, position)
    option_id [unique, name: 'OptionValue_one_default_per_option', note: 'Partiel : WHERE is_default']
    (option_id, `lower(btrim(label))`) [unique, name: 'OptionValue_option_id_label_ci_key', note: 'Unique sans casse ni espaces de bord (migration catalog_unique_names) : libellé unique par menu']
  }
}

// Menus d'un lot.
// Brouillon : réglages facultatifs (absence de ligne = menu affiché) ; tous les menus du modèle s'appliquent.
// Publication : instantané, une ligne par menu du modèle ; un menu créé ensuite ne s'applique pas
// au lot (sa valeur par défaut vaut implicitement). Hors brouillon, lignes ni ajoutées ni retirées
// (BatchOption_snapshot). Fonction batch_menus(batch) : menus applicables et masqués.
// Masquer (brouillon, sondage) supprime les choix des configurations ouvertes dans ce menu (retour au
// défaut, trigger BatchOption_sync_choices) ; démasquer leur donne l'item du défaut (0 €).
Table BatchOption {
  batch_id uuid [not null]
  model_id uuid [not null, note: 'Redondant : garantit batch et menu du même modèle']
  option_id uuid [not null]
  hidden bool [not null, default: false, note: 'Menu masqué : défaut appliqué d\'office, aucun item de configuration dans ce menu (triggers). Modifiable en draft et survey seulement']

  indexes {
    (batch_id, option_id) [pk]
  }
}
Ref: BatchOption.(batch_id, model_id) > Batch.(id, model_id) [delete: cascade]
Ref: BatchOption.(option_id, model_id) > Option.(id, model_id)

// Disponibilité / prix d'une valeur d'option pour un batch donné.
// Brouillon : absence de ligne = hérite du modèle (proposée, prix catalogue, sans limite).
// Publication : instantané, une ligne par valeur des menus du lot. Ensuite absence de ligne = valeur
// créée après la publication, non proposée ; « Proposer sur ce lot » = insérer sa ligne (menu
// applicable, BatchOptionValue_option_applicable ; lot de survey à in_transit, BatchOptionValue_batch_open).
// Lignes jamais supprimées hors brouillon (BatchOptionValue_snapshot).
// « Option retirée » pour ce lot = enabled = false ; jamais sur la valeur par défaut (trigger différé).
// v5i : retirer une valeur sur un lot dont les wishlists sont figées (batch_wishlists_frozen : précommande à en transit)
// ramène au défaut du menu (0 €) les configurations ouvertes qui l'avaient choisie (BatchOptionValue_withdraw_from_wishlists,
// batch_reset_withdrawn_choices) ; un retrait fait au sondage est appliqué à l'ouverture des précommandes
// (BatchStatusTransition_apply). Les lignes de commande (configurations verrouillées) gardent leur choix. Journal :
// WishlistOptionWithdrawal.
// Fonction batch_offered_values(batch) : valeurs proposées et prix effectif.
// Une valeur non proposée ne peut pas entrer dans une nouvelle configuration du lot (trigger).
Table BatchOptionValue {
  batch_id uuid [not null]
  model_id uuid [not null, note: 'Redondant : garantit batch et option du même modèle']
  option_id uuid [not null]
  option_value_id uuid [not null]
  enabled bool [not null, default: true]
  price_override bigint [note: 'NULL = prix catalogue. CHECK >= 0 ; NULL ou 0 sur la valeur par défaut (trigger différé)']
  max_qty int [note: 'NULL = illimité. Lignes payées + réservées portant cette valeur <= max_qty (trigger). CHECK >= 0']

  indexes {
    (batch_id, option_value_id) [pk]
  }
}
Ref: BatchOptionValue.(batch_id, model_id) > Batch.(id, model_id) [delete: cascade]
Ref: BatchOptionValue.(option_id, model_id) > Option.(id, model_id)
Ref: BatchOptionValue.(option_value_id, option_id) > OptionValue.(id, option_id)

// ─────────────────────────────────────────────
// Produits d'options et stock commun
// ─────────────────────────────────────────────

// Produit d'option : produit physique acheté tel quel (ex. Silent kit) et unité de stock. Partagé par
// les valeurs d'option de plusieurs modèles. Stock commun à tous les lots, indépendant d'eux :
// somme de PartStockMovement.qty, jamais négative (Part_stock_non_negative, différé, sous verrou du produit).
Table Part {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  reference text

  indexes {
    `lower(btrim(name))` [unique, name: 'Part_name_ci_key', note: 'Unique sans casse ni espaces de bord (migration catalog_unique_names)']
  }
}

Table OptionValuePart {
  option_value_id uuid [not null, ref: > OptionValue.id]
  part_id uuid [not null, ref: > Part.id]
  qty int [not null, default: 1, note: 'CHECK > 0']

  indexes {
    (option_value_id, part_id) [pk]
  }
}

// Commande du produit d'option pour un lot : un workflow par produit et par lot (décision manuelle).
// Non visible des utilisateurs. Le passage en Tuning suppose toutes les lignes « delivered » (domaine).
// Livraison = status delivered + mouvement de réception rattaché, dans la même transaction
// (BatchPartOrder_reception, différé). Lot et produit figés ; qty figée une fois livrée (BatchPartOrder_immutable).
Table BatchPartOrder {
  id uuid [pk, default: `gen_random_uuid()`]
  batch_id uuid [not null, ref: > Batch.id]
  part_id uuid [not null, ref: > Part.id]
  qty int [not null, note: 'CHECK > 0']
  status part_order_status [not null, default: 'ordering', note: 'Avance seulement (trigger)']
  ordered_at timestamptz [not null, default: `now()`]
  delivered_at timestamptz [note: 'CHECK : renseigné ssi status = delivered']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (batch_id, part_id) [unique]
    (id, part_id) [unique, note: 'Cible de la FK composite depuis PartStockMovement']
    (part_id, status) [note: 'Quantités commandées / en route (part_stock)']
  }
}

// Journal append-only du stock commun (PartStockMovement_append_only). Stock physique = somme de qty.
// CHECK PartStockMovement_kind_check : voir part_movement_kind.
// kit_mounted : le produit équipe une valeur d'option du modèle du lot (PartStockMovement_kit_model) ;
// il sort de la demande du lot (batch_part_needs.mounted_qty).
Table PartStockMovement {
  id uuid [pk, default: `gen_random_uuid()`]
  part_id uuid [not null, ref: > Part.id]
  kind part_movement_kind [not null]
  qty int [not null, note: 'Signé : entrée > 0, sortie < 0']
  batch_part_order_id uuid [note: 'reception d\'une commande de lot (même produit) ; au plus une par commande']
  batch_id uuid [ref: > Batch.id, note: 'kit_mounted : lot de la machine']
  machine_id uuid [note: 'kit_mounted : machine du lot (facultatif)']
  note text [note: 'Motif ; obligatoire pour adjustment']
  created_by_auth_user_id bigint [not null, note: 'auth.users.id de l\'admin. CHECK > 0']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (batch_part_order_id, part_id) [unique, note: 'Une réception par commande']
    (part_id, created_at)
    (batch_id, part_id) [note: 'Kits montés par lot']
    machine_id
  }
}
Ref: PartStockMovement.(batch_part_order_id, part_id) > BatchPartOrder.(id, part_id)
Ref: PartStockMovement.(machine_id, batch_id) > Machine.(id, batch_id)

// Vues (SQL, calculées à la lecture, jamais stockées) :
// part_stock(part_id, on_hand, ordering_qty, awaiting_delivery_qty)
//   stock physique (journal) ; commandé ; en attente de livraison (BatchPartOrder non livrées).
// batch_part_needs(batch_id, part_id, batch_status, firm_qty, potential_qty, mounted_qty,
//                  remaining_qty, ordered_qty, delivered_qty)
//   firm_qty : lignes payées + factures en attente non expirées (order_holds_stock), × OptionValuePart.qty ;
//   potential_qty : wishlists non retirées d'un lot au sondage ; mounted_qty : kits montés sur le lot ;
//   remaining_qty = max(firm − mounted, 0), 0 pour un lot clos ou annulé ;
//   ordered_qty : kits des commandes non livrées ; delivered_qty : kits effectivement reçus (réceptions rattachées,
//   pas la quantité commandée : 3 reçus sur 6 commandés comptent 3).
// part_stock_pressure(part_id, name, reference, on_hand, ordering_qty, awaiting_delivery_qty,
//                     firm_demand, potential_demand, pressure, over_pressure, shortfall, to_order)
//   firm_demand = Σ remaining_qty ; pressure = firm_demand / on_hand (NULL si demande sans stock, 0 sans
//   demande) ; over_pressure = pression > 1 (avertissement) ; shortfall = max(firm − on_hand, 0) ;
//   to_order = max(firm − on_hand − commandé − en route, 0). potential_demand affichée à part.

// ─────────────────────────────────────────────
// Machines physiques
// ─────────────────────────────────────────────

// Suivi d'expédition par machine (expédition partielle d'un lot possible ;
// plusieurs machines d'un même colis partagent tracking_number).
// Trigger : une machine in_transit est rattachée à une ligne active.
Table Machine {
  id uuid [pk, default: `gen_random_uuid()`]
  model_id uuid [not null]
  batch_id uuid [not null]
  serial text [note: 'CHECK non vide']
  psu_serial text
  functional_status machine_functional_status [not null, default: 'unknown']
  logistical_status machine_logistical_status [not null, default: 'expected', note: 'CHECK : in_preparation/ready/in_transit => functional ok ou degraded']
  note text [note: 'Motif (machine morte, hashboard, colis perdu…), backoffice uniquement']
  received_at timestamptz [note: 'CHECK : requis hors expected/missing']
  carrier text [note: 'Transporteur, renseigné à la remise']
  tracking_number text
  tracking_url text [note: 'Lien de suivi optionnel. CHECK ^https?://']
  shipped_at timestamptz [note: 'CHECK : requis pour in_transit, delivered, lost']
  delivered_at timestamptz [note: 'CHECK : requis pour delivered']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id, batch_id) [unique, note: 'Cible des FK composites depuis OrderLine / OrderLineAssignment']
    (model_id, serial) [unique, note: 'Numéro de série unique par modèle (NULL autorisés)']
    (batch_id, logistical_status)
  }
}
Ref: Machine.(batch_id, model_id) > Batch.(id, model_id)

Table HashboardStatus {
  id uuid [pk, default: `gen_random_uuid()`]
  machine_id uuid [not null, ref: > Machine.id]
  index int [not null, note: 'CHECK >= 0 (borne haute = Model.hashboard_qtt, vérifiée en domaine)']
  status hashboard_status [not null]

  indexes {
    (machine_id, index) [unique]
  }
}

// ─────────────────────────────────────────────
// Utilisateurs
// ─────────────────────────────────────────────

// Pas d'e-mail sur l'utilisateur (auth-service n'en a pas) : il est figé sur chaque facture (Order.contact_email) ; le
// dernier connu se lit dans la vue user_contact_email (v5i).
Table User {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_user_id bigint [not null, unique, note: 'auth.users.id du service d\'auth (BIGINT auto-incrémenté, claim sub du JWT). CHECK > 0']
  created_at timestamptz [not null, default: `now()`]
}

// Carnet d'adresses (facturation et livraison). Donnée personnelle : jamais loggée.
// Une adresse référencée par une commande n'est pas modifiable (trigger) : on en crée
// une nouvelle et on archive l'ancienne (archived_at), pour garder l'historique exact.
Table Address {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > User.id]
  full_name text [not null]
  company text
  line1 text [not null]
  line2 text
  postal_code text [not null]
  city text [not null]
  country char(2) [not null, note: 'ISO 3166-1 alpha-2. CHECK ^[A-Z]{2}$']
  phone text
  created_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    (id, user_id) [unique, note: 'Cible des FK composites : l\'adresse appartient au même utilisateur']
    user_id
  }
}

// ─────────────────────────────────────────────
// Configuration choisie (une par wishlist, une par ligne de commande)
// ─────────────────────────────────────────────

// La ligne de commande reçoit une COPIE de la configuration de la wishlist (prix figés au moment
// de la commande) ; une configuration n'est jamais partagée entre wishlist et ligne (trigger).
Table Configuration {
  id uuid [pk, default: `gen_random_uuid()`]
  batch_id uuid [not null]
  model_id uuid [not null, note: 'Redondant : garantit que les options choisies sont du modèle du batch']
  base_price bigint [not null, note: 'Snapshot de Batch.resale_unit_price. CHECK >= 0']
  created_at timestamptz [not null, default: `transaction_timestamp()`, note: 'Horloge de la base : laisser le défaut']
  updated_at timestamptz [not null, default: `transaction_timestamp()`, note: 'Dernière modification des choix (items, prix de base). Tenue par la base (ConfigurationItem_touch, Configuration_set_updated_at) ; inchangée par le verrouillage']
  locked_at timestamptz [note: 'Posé par la base à l\'insertion de la ligne de commande ; ensuite configuration et items immuables']

  indexes {
    (id, batch_id) [unique, note: 'Cible des FK composites depuis Wishlist / OrderLine']
    (id, model_id) [unique, note: 'Cible de la FK composite depuis ConfigurationItem']
    batch_id
  }
}
Ref: Configuration.(batch_id, model_id) > Batch.(id, model_id)

// Configuration complète (Configuration_complete, différé) : un item par menu visible du lot ayant un
// défaut, « Sans » compris (0 €). Instantané : ne suit plus le catalogue. Pas d'item pour un menu masqué
// ou non applicable au lot (défaut implicite) ; valeur proposée par le lot (batch_offered_values) ;
// trigger ConfigurationItem_guard. À la (re)publication, les configurations ouvertes reçoivent le défaut
// des menus visibles qui leur manquent. Configuration d'une wishlist : immuable hors draft/survey (voir Wishlist).
Table ConfigurationItem {
  configuration_id uuid [not null]
  model_id uuid [not null]
  option_id uuid [not null]
  option_value_id uuid [not null]
  unit_price bigint [not null, note: 'Snapshot : COALESCE(price_override, price). CHECK >= 0 ; 0 pour la valeur par défaut (trigger)']

  indexes {
    (configuration_id, option_id) [pk, note: 'Une seule valeur par option']
    option_value_id [note: 'Comptage des ventes par valeur (max_qty)']
  }
}
Ref: ConfigurationItem.(configuration_id, model_id) > Configuration.(id, model_id) [delete: cascade]
Ref: ConfigurationItem.(option_id, model_id) > Option.(id, model_id)
Ref: ConfigurationItem.(option_value_id, option_id) > OptionValue.(id, option_id)

// ─────────────────────────────────────────────
// Wishlist, commandes, paiement
// ─────────────────────────────────────────────

// Intérêt sans argent : une ligne = une machine souhaitée.
// Convertie = référencée par une ligne active d'une commande payée (au plus une, trigger différé).
// Création ou réactivation uniquement pendant le sondage du lot (trigger Wishlist_batch_survey) ; retrait à tout moment,
// sauf une wishlist convertie (trigger Wishlist_guard_converted, contrainte "Wishlist_converted", sous verrou partagé du
// lot, le même que la conversion) : on renonce alors par l'annulation de la commande (décision Hugo 2026-10-07).
// Plafond (Wishlist_cap, sous verrou de l'utilisateur) : wishlists non retirées d'un utilisateur sur un lot
// <= least(ShopSettings.wishlist_max_per_user_per_batch, Batch.quantity), à la création et à la réactivation.
// Retirer ses wishlists après l'ouverture des précommandes fait perdre la priorité (order_priority_allows) ; quand toutes
// les wishlists actives du lot sont converties, la journée de priorité se termine pour tout le monde.
// Configuration figée dès la précommande (décision Hugo 2026-10-07) : la configuration d'une wishlist
// (retirée ou non : Configuration, ConfigurationItem, Wishlist.configuration_id) ne change que si le lot
// est draft ou survey (triggers *_wishlist_frozen / Wishlist_configuration_frozen, contrainte
// "Wishlist_configuration_frozen"). L'application ne laisse l'utilisateur la modifier qu'au sondage ;
// le brouillon reste permis en base pour le masquage de menu et la complétion à la (re)publication.
// Exception contrôlée (v5i, décision Hugo 2026-10-09) : un item dont la valeur n'est plus proposée par le lot revient
// au défaut du menu, gratuit (configuration_item_withdrawal_reset : même menu, défaut, 0 €, ancienne valeur non
// proposée) ; la date de dernière modification suit (Configuration : seul updated_at change). Chaque ajustement est
// journalisé (WishlistOptionWithdrawal). La wishlist n'est pas retirée et garde sa priorité.
Table Wishlist {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > User.id]
  batch_id uuid [not null, ref: > Batch.id]
  configuration_id uuid [not null, unique]
  created_at timestamptz [not null, default: `transaction_timestamp()`, note: 'Horloge de la base : laisser le défaut']
  cancelled_at timestamptz [note: 'Retrait par l\'utilisateur ; refusé si la wishlist est convertie (Wishlist_converted)']

  indexes {
    (configuration_id, batch_id) [unique, note: 'Redondant, requis par Prisma (relation 1:1 composite)']
    (id, user_id, batch_id) [unique, note: 'Cible de la FK composite depuis OrderLine (même utilisateur, même lot)']
    (batch_id, user_id)
    user_id
  }
}
Ref: Wishlist.(configuration_id, batch_id) - Configuration.(id, batch_id)

// Commande = facture d'un utilisateur sur un lot, payée en totalité (pas d'acompte).
// « Précommande » ou « commande simple » : déduit du statut du lot à created_at.
// Jamais supprimée (Order_no_delete) ; adresse de paiement unique, jamais réutilisée, immuable.
// Création (trigger Order_guard, sous verrou de l'utilisateur FOR NO KEY UPDATE) : pending_payment, rien reçu,
// réservation <= 30 min, lot ouvert aux commandes (Order_batch_open : précommande à packaging, batch_accepts_orders),
// journée de priorité (Order_priority_window : quota de machines non épuisé ; par ligne OrderLine_priority_quota),
// et les garde-fous anti-accaparement (ShopSettings), par utilisateur et par lot :
//   Order_one_live_per_user_batch (facture qui réserve, expires_at > now()) : aucune autre facture pending_payment non
//   expirée du même utilisateur sur ce lot ;
//   Order_abandoned_limit (toute création) : l'utilisateur n'est pas bloqué sur ce lot (user_batch_blocked_at) ;
//   Order_abandoned_cooldown (facture qui réserve) : pas d'abandon depuis moins de abandoned_order_cooldown_minutes
//   (user_batch_cooldown_ends_at).
// Facture abandonnée : order_abandoned_at(order) = instant où elle a pris fin sans paiement complet : cancelled_at
// (annulée, même payée ensuite, tant que l'admin ne l'a pas acceptée) ; expires_at (réservation terminée, reçu <
// attendu, appoint compris) ; least(expires_at, refunded_at) (remboursée sans avoir été payée intégralement, ex.
// remboursement d'un paiement partiel choisi par l'utilisateur). NULL si payée (paid_at) ou intégralement payée sans
// être acceptée (paiement tardif sans place). Abandons comptés : depuis la dernière levée de l'admin
// (user_batch_abandoned_orders, OrderBlockRelease). Blocage : au abandoned_order_limit-ième abandon dans une fenêtre
// glissante de abandoned_order_window_hours heures ; il dure jusqu'à une levée de l'admin (vue order_creation_blocks).
// Journée de priorité : batch_priority_ends_at(lot) = 1re ouverture des précommandes + 1 jour, si le lot est passé par le
// sondage et a au moins une wishlist active (sinon NULL : pas de priorité) ; plus tôt, à la dernière conversion
// (greatest(ouverture, max paid_at)), dès que toutes les wishlists actives sont converties. Pendant la journée, un utilisateur commande au
// plus user_priority_quota (ses wishlists actives) machines qui occupent le stock (user_batch_held_lines) ;
// order_priority_machines_left(lot, utilisateur) = reste (NULL hors journée), order_priority_allows = reste > 0 ou NULL.
// Réservation : la facture occupe le stock jusqu'à expires_at (30 min, horloge de la base).
// Immuables : user, batch, total_amount, expected_sats, payment_address, created_at, expires_at, paid_at,
// refunded_at et cancelled_at une fois posés ; cancelled_at seulement au passage à cancelled (Order_immutable). received_sats ne change que par un Payment (Order_received_via_payment).
// Trigger différé Order_check : >= 1 ligne ; total_amount = somme des lignes ; pas de remboursement ni de machine
// tant que non payée ; paid => au moins une ligne active ; refunded => aucune ligne active ; remboursements
// (Order_refunds, Refund_kind_lines, Refund_prorata, Refund_overpayment : voir Refund).
// Au passage à refunded (Order_refunded_in_full, différé) : tout le reçu sorti du solde (remboursé ou classé sans suite)
// pour une facture jamais acceptée ; pour une commande payée, le prix rendu en entier, l'excédent pouvant rester (v5i, voir Refund).
// Vue order_payment_balance(order_id, batch_id, user_id, status, expected_sats, received_sats, refunded_sats,
//   outstanding_sats, refund_due_sats, awaiting_decision, awaiting_user_decision, needs_admin_decision, unsettled_sats,
//   user_refund_allowed, needs_admin_attention, abandoned_at, fits_stock) :
//   refunded_sats = sats sortis du solde (versés + frais à la charge de l'utilisateur, refund_debited_sats) ;
//   outstanding_sats = appoint attendu (facture en attente ou expirée) ;
//   refund_due_sats = excédent d'une facture payée (hors excédents déjà remboursés) ; jamais remboursé d'office (v5h) ;
//   awaiting_decision = paiement complet sur une facture en attente/expirée d'un lot ouvert : accepter (paid) s'il reste
//   de la place, sinon rembourser (automatique) ;
//   awaiting_user_decision = facture expirée partiellement payée d'un lot ouvert : l'utilisateur choisit appoint ou
//   remboursement (frais à sa charge) ;
//   needs_admin_decision = sats non affectés sur une facture remboursée, annulée, ou impayée d'un lot fermé aux
//   commandes : décision de l'admin, jamais de remboursement automatique ;
//   unsettled_sats = sats reçus non affectés (excédent si payée, sinon reçu − sorti du solde) ;
//   user_refund_allowed = l'utilisateur peut demander le remboursement de son paiement partiel (Refund_partial_payment_allowed) ;
//   needs_admin_attention = « à traiter » au backoffice : needs_admin_decision, awaiting_user_decision ou awaiting_decision
//   (paiement complet resté sans traitement automatique, ex. réservation vivante qui ne tient plus dans le stock) ;
//   abandoned_at = order_abandoned_at ;
//   fits_stock = pour awaiting_decision : la facture tiendrait dans le stock si elle était payée maintenant
//   (batch_stock_violation, sans verrou ; la décision reste Order_fits_stock) ; NULL sinon ;
//   unsent_refund_sats = sats des remboursements créés mais pas encore envoyés ;
//   refund_address_missing = un remboursement non envoyé n'a d'adresse ni sur lui ni sur la facture : contacter
//   l'utilisateur (compris dans needs_admin_attention) ;
//   user_renounce_allowed = facture payée d'un lot au plus en Précommande (batch_allows_user_renunciation) ;
//   overpayment_unrefunded = facture payée dont l'excédent n'est pas entièrement remboursé : aucun excédent n'est remboursé
//   d'office, quel qu'en soit le montant (v5h), l'admin décide (compris dans needs_admin_attention).
//   Excédents comptés BRUT (refund_debited_sats) dans refunded_sats, unsettled_sats et refund_due_sats.
// Adresse de remboursement (refund_address) : facultative, saisie à la création ; modifiable (utilisateur, admin) tant
// qu'aucun remboursement de la facture n'est envoyé (Order_refund_address_frozen, sous verrou de la facture) ; jamais une
// adresse de paiement de la boutique (Order_refund_address_ours, bitcoin_address_is_ours). Toute écriture exige un acteur
// déclaré dans la transaction (declare_actor) et est journalisée (OrderRefundAddressChange, trigger Order_refund_address_log).
// Renoncement de l'utilisateur à une commande payée (lignes ou facture entière, frais utilisateur) : voir Refund. Ce
// n'est pas un abandon (paid_at posé : order_abandoned_at NULL).
// v5i : order_payment_balance.dismissed_sats (ajoutée en fin) = sats classés sans suite (OrderExcessDismissal) ; ils
// sortent de unsettled_sats et refund_due_sats (donc de needs_admin_decision, overpayment_unrefunded et
// needs_admin_attention). refunded_sats reste les seuls remboursements.
// E-mail du client (contact_email) : instantané sur la facture, à qui l'admin écrit pour cette facture. Pas de copie sur
// User : le dernier e-mail connu se lit dans la vue user_contact_email(user_id, contact_email, order_id, created_at)
// (facture la plus récente qui en porte un ; préremplissage de la facture suivante). Donnée personnelle : jamais loggée.
Table Order {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > User.id]
  batch_id uuid [not null, ref: > Batch.id]
  billing_address_id uuid [not null]
  shipping_address_id uuid [not null, note: 'Modifiable (nouvelle adresse du même utilisateur) jusqu\'à l\'expédition, côté domaine']
  status order_status [not null, default: 'pending_payment']
  total_amount bigint [not null, note: 'Centimes. CHECK > 0. Immuable']
  expected_sats bigint [not null, note: 'Montant attendu en satoshis, taux figé à la création. CHECK > 0. Immuable']
  payment_method payment_method [not null, default: 'bitcoin']
  payment_address text [not null, unique, note: 'Adresse Bitcoin de réception, une par facture, jamais réutilisée. CHECK non vide. Immuable']
  refund_address text [note: 'Adresse Bitcoin de remboursement de l\'utilisateur (facultative). CHECK Order_refund_address_check : alphanumérique 26 à 100 caractères, <> payment_address. Figée dès qu\'un remboursement est envoyé']
  contact_email text [note: 'E-mail du client, saisi à la création. Obligatoire pour une nouvelle facture (trigger Order_contact_email_required, créé désactivé en v5i, activé avec le backend) ; NULL = facture antérieure à v5i. CHECK Order_contact_email_check : partie locale @ domaine à deux libellés ou plus, sans espace, 254 caractères au plus, casse conservée. Jamais modifié une fois posé (Order_contact_email_frozen)']
  created_at timestamptz [not null, default: `transaction_timestamp()`, note: 'Horloge de la base (= now(), comme expires_at) : laisser le défaut. Immuable']
  expires_at timestamptz [not null, default: `now() + interval '30 minutes'`, note: 'Fin de la réservation. Laisser le défaut ; <= now() + 30 min à l\'insertion, immuable (trigger). CHECK > created_at']
  paid_at timestamptz [note: 'Passage à paid (paiement intégral accepté) ; NULL pour un paiement refusé faute de place']
  received_sats bigint [not null, default: 0, note: 'Somme des Payment.amount_sats, tenue par la base (Payment_apply). CHECK >= 0 ; paid => >= expected_sats']
  expired_at timestamptz
  cancelled_at timestamptz [note: 'Annulation volontaire (passage à cancelled), ensuite immuable']
  refunded_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  Note: 'CHECK Order_status_dates_check : dates cohérentes avec le statut (cancelled : cancelled_at seul)'

  indexes {
    (id, user_id, batch_id) [unique, note: 'Cible de la FK composite depuis OrderLine']
    (batch_id, status)
    (batch_id, paid_at) [note: 'Surplus : rembourser les dernières payées d\'abord']
    (user_id, batch_id, expires_at) [note: 'Garde-fous : facture vivante, délai après expiration (par utilisateur et par lot)']
  }
}
Ref: Order.(billing_address_id, user_id) > Address.(id, user_id)
Ref: Order.(shipping_address_id, user_id) > Address.(id, user_id)

// Une ligne = une machine, avec sa configuration verrouillée. Jamais supprimée (OrderLine_no_delete) : on rembourse.
// Ajout seulement à la création de la facture (pending_payment, total figé) ; au plus
// ShopSettings.order_max_lines lignes par facture (Order_max_lines, à l'insertion) ; wishlist liée non retirée
// (OrderLine_wishlist_live) ; journée de priorité : machines de l'utilisateur occupant le stock du lot, lignes de la
// facture comprises, <= ses wishlists actives (OrderLine_priority_quota) ; ensuite seuls machine_id (via OrderLineAssignment) et refund_id (une fois) évoluent.
// Ordre : position, posée par la base à l'insertion (1, 2, 3…), unique par facture.
// Ligne active = refund_id NULL et commande paid : elle retire une machine du stock.
// Ligne réservée = refund_id NULL et commande pending_payment non expirée : elle occupe aussi le stock.
Table OrderLine {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null]
  user_id uuid [not null, note: 'Redondant : wishlist et commande du même utilisateur']
  batch_id uuid [not null, note: 'Redondant : configuration, wishlist, machine du même lot']
  configuration_id uuid [not null, unique]
  wishlist_id uuid [note: 'Wishlist convertie (priorité). NULL si commande sans intérêt préalable']
  amount bigint [not null, note: 'Centimes : base_price + somme des items (trigger différé). CHECK >= 0']
  machine_id uuid [note: 'Attribuée au Contrôle ; modifiée uniquement via OrderLineAssignment']
  refund_id uuid [note: 'Ligne annulée et remboursée']
  position int [not null, default: 0, note: 'Rang dans la facture (1, 2, 3… : ordre d\'insertion, donc de la requête). Posé par la base (OrderLine_guard, valeur fournie ignorée), immuable. CHECK >= 1']
  created_at timestamptz [not null, default: `transaction_timestamp()`, note: 'Horloge de la base : laisser le défaut']

  indexes {
    (configuration_id, batch_id) [unique, note: 'Redondant, requis par Prisma (relation 1:1 composite)']
    (id, batch_id) [unique, note: 'Cible de la FK composite depuis OrderLineAssignment']
    (order_id, position) [unique, note: 'Ordre des lignes d\'une facture ; couvre les recherches par order_id']
    (order_id, wishlist_id) [unique, note: 'Une wishlist au plus une fois par facture']
    machine_id [unique, name: 'OrderLine_machine_id_active_key', note: 'Partiel : WHERE refund_id IS NULL']
    batch_id
    wishlist_id
  }
}
Ref: OrderLine.(order_id, user_id, batch_id) > Order.(id, user_id, batch_id)
Ref: OrderLine.(configuration_id, batch_id) - Configuration.(id, batch_id)
Ref: OrderLine.(wishlist_id, user_id, batch_id) > Wishlist.(id, user_id, batch_id)
Ref: OrderLine.(machine_id, batch_id) > Machine.(id, batch_id)
Ref: OrderLine.(refund_id, order_id) > Refund.(id, order_id)

// Journal append-only des attributions : attribution au Contrôle, remplacement d'une machine
// morte ou perdue, retrait (machine_id NULL). L'insertion met à jour OrderLine.machine_id.
// Conditions (trigger) : ligne active ; machine in_stock/in_preparation/ready et non faulty.
Table OrderLineAssignment {
  id uuid [pk, default: `gen_random_uuid()`]
  order_line_id uuid [not null]
  batch_id uuid [not null]
  machine_id uuid [note: 'NULL = machine retirée sans remplacement']
  changed_by_auth_user_id bigint [not null, note: 'auth.users.id. CHECK > 0']
  reason text
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (order_line_id, created_at)
    machine_id
  }
}
Ref: OrderLineAssignment.(order_line_id, batch_id) > OrderLine.(id, batch_id)
Ref: OrderLineAssignment.(machine_id, batch_id) > Machine.(id, batch_id)

// Paiement reçu sur l'adresse d'une facture (service Bitcoin maison ; simulé au jalon 4 par un point d'entrée
// interne). Journal append-only (Payment_append_only), jamais refusé par la base quel que soit l'état de la facture
// ou du lot : l'argent reçu est tracé, puis accepté (paid) ou remboursé. L'insertion ajoute amount_sats à
// Order.received_sats (Payment_apply, sous verrou de la ligne Order : des paiements simultanés s'additionnent).
Table Payment {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > Order.id]
  amount_sats bigint [not null, note: 'CHECK > 0']
  txid text [not null, note: 'Transaction Bitcoin. CHECK non vide']
  vout int [not null, note: 'Sortie de la transaction. CHECK >= 0']
  received_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (txid, vout) [unique, note: 'Une sortie de transaction n\'est comptée qu\'une fois']
    (order_id, received_at)
  }
}

// Remboursement au même moyen que le paiement (Bitcoin), en sats reçus (pas de conversion). Jamais supprimé.
// kind (refund_kind) : cancellation (lignes liées par OrderLine.refund_id ; amount >= leurs montants, ou tout ce qui
// reste de la facture), discount (rabais, aucune ligne), overpayment (0 €, sats reçus en trop).
// amount_sats est toujours ce que reçoit l'utilisateur ; brut = sats sortis du solde = amount_sats + frais si
// network_fee_payer = user (refund_debited_sats).
// Règles (Order_check, différé), toutes sur le brut :
//   Order_refunds      annulations + rabais (centimes) <= total_amount ; tous remboursements (brut) <= received_sats ;
//   Refund_prorata     facture payée : brut des annulations + rabais = prorata de expected_sats sur les centimes
//                      remboursés (arrondi inférieur ou supérieur du cumul). Fonction refund_prorata_sats(order, amount),
//                      qui renvoie le brut ;
//   Refund_overpayment facture payée : excédents remboursés (brut) <= received_sats - expected_sats ;
//   Refund_cause_remainder  le reliquat d'excédent d'un renoncement (kind overpayment, cause user_renounce) n'existe
//                      que si la facture passe à refunded (renoncement à toute la facture).
// Sats classés sans suite (OrderExcessDismissal) : comptés avec les remboursements dans Order_refunds (remboursés +
// classés <= reçu) et Refund_overpayment (excédents remboursés + classés <= reçu − attendu).
// Au passage à refunded (Order_refunded_in_full, v5i) : facture jamais acceptée (paid_at NULL) : somme des bruts +
// classés = received_sats ; commande payée (paid_at posé) : annulations et rabais (brut) >= expected_sats (le prix
// payé est rendu en entier), l'excédent peut rester : « à traiter » (needs_admin_decision), l'admin choisit de le
// rembourser ou de le classer sans suite (décision Hugo 2026-10-09 : plus de départ obligatoire avec l'annulation).
// Motif (cause) et frais réseau, à l'insertion (trigger Refund_cause_rules) :
//   Refund_cause_fee_payer      network_fee_payer = refund_cause_fee_payer(cause) ;
//   Refund_system_above_fee     traitement automatique : frais connus et brut > frais, sinon rien d'automatique ;
//   Refund_cause_check          v5h : le motif overpayment n'est permis qu'à l'initiateur admin (contrainte NOT VALID :
//                               les excédents remboursés d'office avant v5h restent lisibles) ;
//   Refund_partial_payment_allowed  partial_payment : facture en attente ou expirée, 0 < reçu < attendu, lot ouvert
//                               (sous verrou de la facture) ; Refund_partial_payment_after_expiry : l'admin seulement
//                               après la fin de la réservation ;
//   Refund_late_payment_full    late_payment_no_room : facture non acceptée, reçu >= attendu.
// Frais à la charge de l'utilisateur : le versement doit les couvrir (amount_sats > 0, Refund_user_net_positive).
// Frais portés par une seule ligne (CHECK Refund_fee_single_line_check) : le reliquat d'excédent qui part avec
// l'annulation de toute la facture ne porte aucun frais à la charge de l'utilisateur (network_fee_sats = 0).
// Renoncement (cause user_renounce, cancellation au prorata ou reliquat, frais à la charge de l'utilisateur) :
// facture payée (Refund_user_renounce_paid). Initié par l'utilisateur : lot au plus en Précommande
// (Refund_user_renounce_window, sous verrou du lot : sérialisé avec les transitions de statut). Initié par
// l'admin (à la demande de l'utilisateur, tracé par Refund_admin_traced_check) : à toute étape (v5g).
// Adresse effective tant qu'il n'est pas envoyé : coalesce(destination_address (choix de l'admin), Order.refund_address) ;
// aucune : « à traiter » (order_payment_balance.refund_address_missing). Jamais une adresse de paiement de la boutique
// (Refund_destination_ours).
// Envoi (trigger Refund_guard) : sent_at posé par la base (valeur fournie remplacée), reference et destination_address
// requises (Refund_sent_check) ; l'adresse inscrite doit être l'adresse effective lue sous verrou de la facture
// (Refund_sent_destination). Ensuite tout est figé (Refund_sent_frozen). order_id, kind, cause, network_fee_payer,
// initiated_by, created_by_auth_user_id, created_at toujours immuables (Refund_immutable).
// Vue refunds_to_send(refund_id, order_id, batch_id, user_id, kind, initiated_by, amount_sats, network_fee_sats,
//   network_fee_payer, destination_address (effective), destination_source ('refund' | 'order' | NULL), address_missing,
//   created_at, cause) : remboursements non envoyés.
Table Refund {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > Order.id]
  kind refund_kind [not null, note: 'Immuable']
  cause refund_cause [not null, note: 'Motif. Immuable. Fixe le payeur des frais à la création ; nature et initiateur permis (Refund_cause_check)']
  initiated_by refund_initiator [not null, note: 'Qui l\'a décidé. Immuable']
  created_by_auth_user_id bigint [note: 'auth.users.id de l\'admin ; requis ssi initiated_by = admin (CHECK > 0). Immuable']
  amount bigint [not null, note: 'Centimes. CHECK >= 0 ; = 0 si et seulement si overpayment (Refund_kind_check)']
  amount_sats bigint [not null, note: 'Montant BTC reçu par l\'utilisateur (satoshis), net des frais s\'ils sont à sa charge. CHECK > 0']
  network_fee_sats bigint [note: 'Frais réseau (satoshis). CHECK >= 0 ; requis si network_fee_payer = user ou initiated_by = system ; 0 pour un reliquat à frais utilisateur. Figé une fois envoyé']
  network_fee_payer refund_fee_payer [not null, default: 'shop', note: '= refund_cause_fee_payer(cause) à la création (Refund_cause_fee_payer). Immuable']
  reason text [not null, note: 'CHECK non vide']
  destination_address text [note: 'Adresse choisie par l\'admin (sinon celle de la facture). CHECK alphanumérique 26 à 100 caractères. Requise à l\'envoi, figée ensuite']
  reference text [note: 'Référence du remboursement (txid). CHECK non vide ; requise si sent_at']
  created_at timestamptz [not null, default: `clock_timestamp()`, note: 'Horloge de la base ; ordonne les remboursements d\'une même transaction']
  sent_at timestamptz [note: 'Envoi, posé par la base. Ensuite tout est figé']
  sent_by_auth_user_id bigint [note: 'Admin qui a enregistré l\'envoi ; NULL = service de paiement. CHECK > 0 et seulement si sent_at']

  indexes {
    (id, order_id) [unique, note: 'Cible de la FK composite depuis OrderLine']
    order_id
    created_at [name: 'Refund_unsent_created_at_idx', note: 'Partiel : WHERE sent_at IS NULL (refunds_to_send)']
  }
}

// ─────────────────────────────────────────────
// Réglages
// ─────────────────────────────────────────────

// Réglages lus par la base (garde-fous), fonction shop_settings(). Une seule ligne (CHECK id = 1), créée par la
// migration v5, jamais supprimée (ShopSettings_no_delete). Une valeur modifiée ne s'applique qu'aux nouvelles écritures.
Table ShopSettings {
  id smallint [pk, default: 1, note: 'CHECK = 1']
  wishlist_max_per_user_per_batch int [not null, default: 5, note: 'Wishlists non retirées par utilisateur et par lot, bornées par Batch.quantity. CHECK 1 à 1000']
  order_max_lines int [not null, default: 10, note: 'Machines (lignes) par facture. CHECK 1 à 1000']
  abandoned_order_cooldown_minutes int [not null, default: 5, note: 'Délai après une facture abandonnée (annulée, expirée sans paiement complet, remboursée sans avoir été payée) avant d\'en créer une autre sur le même lot. CHECK 0 à 1440']
  abandoned_order_limit int [not null, default: 3, note: 'Au N-ième abandon d\'un utilisateur sur un lot dans la fenêtre : blocage jusqu\'à une levée de l\'admin. CHECK 1 à 100']
  abandoned_order_window_hours int [not null, default: 24, note: 'Fenêtre glissante du plafond d\'abandons (heures). CHECK 1 à 720']
  updated_at timestamptz [not null, default: `now()`]
}

// Levée par l'admin du blocage d'un utilisateur sur un lot (Order_abandoned_limit) : les abandons antérieurs ne comptent
// plus (ni plafond ni délai). Journal append-only (OrderBlockRelease_append_only).
Table OrderBlockRelease {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > User.id]
  batch_id uuid [not null, ref: > Batch.id]
  released_by_auth_user_id bigint [not null, note: 'auth.users.id de l\'admin. CHECK > 0']
  reason text [note: 'CHECK non vide si renseigné']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (user_id, batch_id, created_at) [note: 'Dernière levée (order_block_released_at)']
    batch_id
  }
}

// Journal des écritures de Order.refund_address (saisie à la création, modification, effacement), alimenté par le
// trigger Order_refund_address_log (AFTER, donc seulement les écritures acceptées). Acteur déclaré par la transaction :
// SELECT declare_actor('user' | 'admin', auth_user_id) (set_config local à la transaction) ; sans déclaration :
// refus (OrderRefundAddressChange_actor) ; un « user » doit être l'utilisateur de la facture
// (OrderRefundAddressChange_actor_user). Append-only (OrderRefundAddressChange_append_only).
Table OrderRefundAddressChange {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > Order.id]
  old_address text [note: 'NULL : aucune adresse avant']
  new_address text [note: 'NULL : adresse effacée. CHECK OrderRefundAddressChange_changed_check : <> old_address']
  actor actor_kind [not null]
  actor_auth_user_id bigint [not null, note: 'auth.users.id de l\'utilisateur ou de l\'admin. CHECK > 0']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (order_id, created_at)
  }
}

// Classement sans suite par l'admin (v5i, décision Hugo 2026-10-09) des sats reçus non affectés d'une facture
// (excédent d'une commande payée, reliquat d'un renoncement, versement après un remboursement intégral ou une
// annulation) quand les rendre coûterait au moins autant que les frais réseau. Trigger OrderExcessDismissal_check,
// sous verrou de la facture : facture paid, refunded ou cancelled (OrderExcessDismissal_status : jamais en attente ou
// expirée, l'appoint reste possible ou l'utilisateur décide) ; sats = exactement le non-affecté
// (OrderExcessDismissal_amount, comme order_payment_balance.unsettled_sats). Une seule fois par facture (unique).
// Les sats classés sortent du solde : la facture sort de « À traiter », la trace reste. Une facture annulée classée ne
// peut plus être acceptée (Order_dismissed_final). Cohérence au COMMIT : Order_check. Append-only
// (OrderExcessDismissal_append_only), jamais supprimé.
Table OrderExcessDismissal {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, unique, ref: > Order.id, note: 'Une fois par facture']
  sats bigint [not null, note: 'Montant concerné (satoshis). CHECK > 0 et <= network_fee_sats (OrderExcessDismissal_within_fee_check)']
  network_fee_sats bigint [not null, note: 'Frais réseau estimés d\'un remboursement au moment du classement (service de paiement). CHECK > 0']
  reason text [note: 'Motif libre facultatif. CHECK non vide si renseigné']
  dismissed_by_auth_user_id bigint [not null, note: 'auth.users.id de l\'admin. CHECK > 0']
  created_at timestamptz [not null, default: `clock_timestamp()`]
}

// Option retirée d'un lot pour une wishlist figée (v5i, décision Hugo 2026-10-09) : une ligne par item ramené au défaut
// du menu, écrite par la base (trigger ConfigurationItem_log_withdrawal, quel que soit l'écrivain), pour prévenir
// l'utilisateur. Wishlist retirée ou convertie comprise (l'application choisit qui prévenir ; une ligne de commande
// garde son choix). Append-only (WishlistOptionWithdrawal_append_only).
Table WishlistOptionWithdrawal {
  id uuid [pk, default: `gen_random_uuid()`]
  wishlist_id uuid [not null]
  user_id uuid [not null, note: 'Redondant (FK composite vers Wishlist) : « mes avertissements »']
  batch_id uuid [not null]
  option_id uuid [not null, note: 'Menu concerné']
  withdrawn_value_id uuid [not null, note: 'Valeur retirée que la wishlist portait']
  withdrawn_unit_price bigint [not null, note: 'Son prix figé dans la configuration, centimes. CHECK >= 0']
  default_value_id uuid [not null, note: 'Défaut du menu, désormais porté (0 €). CHECK <> withdrawn_value_id']
  created_at timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (user_id, created_at)
    wishlist_id
    batch_id
  }
}
Ref: WishlistOptionWithdrawal.(wishlist_id, user_id, batch_id) > Wishlist.(id, user_id, batch_id)
Ref: WishlistOptionWithdrawal.(withdrawn_value_id, option_id) > OptionValue.(id, option_id)
Ref: WishlistOptionWithdrawal.(default_value_id, option_id) > OptionValue.(id, option_id)
